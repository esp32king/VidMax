<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_about"
    android:fitsSystemWindows="true">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:overScrollMode="never"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:minHeight="640dp"
            android:orientation="vertical"
            android:paddingStart="28dp"
            android:paddingTop="70dp"
            android:paddingEnd="28dp"
            android:paddingBottom="40dp">

            <com.example.myapplication.ui.NeonTextView
                android:id="@+id/aboutName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:letterSpacing="0.06"
                android:text="@string/about_name"
                android:textColor="@color/blood"
                android:textSize="46sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:letterSpacing="0.05"
                android:text="@string/about_by"
                android:textColor="#FFB98A8A"
                android:textSize="14sp"
                android:textStyle="italic" />

            <FrameLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="26dp">

                <View
                    android:layout_width="300dp"
                    android:layout_height="300dp"
                    android:layout_gravity="center"
                    android:background="@drawable/bg_skull_glow" />

                <ImageView
                    android:id="@+id/aboutSkull"
                    android:layout_width="276dp"
                    android:layout_height="276dp"
                    android:layout_gravity="center"
                    android:adjustViewBounds="true"
                    android:contentDescription="@null"
                    android:scaleType="fitCenter"
                    android:src="@drawable/splash_mark" />
            </FrameLayout>

            <TextView
                android:id="@+id/aboutTag"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="26dp"
                android:gravity="center"
                android:letterSpacing="0.03"
                android:lineSpacingExtra="4dp"
                android:paddingStart="6dp"
                android:paddingEnd="6dp"
                android:shadowColor="#CCE00610"
                android:shadowDx="0"
                android:shadowDy="0"
                android:shadowRadius="14"
                android:text="@string/about_tag_full"
                android:textColor="#FFEDE3E3"
                android:textSize="20sp"
                android:textStyle="bold|italic" />

            <View
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/aboutFooter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="30dp"
                android:gravity="center"
                android:letterSpacing="0.02"
                android:text="@string/footer_credit"
                android:textColor="#FF8A7B7B"
                android:textSize="11sp" />
        </LinearLayout>
    </ScrollView>

    <ImageView
        android:id="@+id/aboutBack"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_gravity="top|start"
        android:layout_marginStart="14dp"
        android:layout_marginTop="18dp"
        android:background="@drawable/bg_close_round"
        android:contentDescription="@string/back"
        android:padding="11dp"
        android:src="@drawable/ic_arrow_back"
        app:tint="@color/blood" />
</FrameLayout>
