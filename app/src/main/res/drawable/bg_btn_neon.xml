<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <corners android:radius="20dp" />
            <gradient
                android:angle="0"
                android:startColor="#FF38F0FF"
                android:endColor="#FFFF6BE2"
                android:type="linear" />
        </shape>
    </item>
    <item android:state_enabled="false">
        <shape android:shape="rectangle">
            <corners android:radius="20dp" />
            <solid android:color="#2AFFFFFF" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="20dp" />
            <gradient
                android:angle="0"
                android:startColor="@color/neon_cyan"
                android:centerColor="#FF49C6FF"
                android:endColor="@color/neon_magenta"
                android:type="linear" />
        </shape>
    </item>
</selector>
